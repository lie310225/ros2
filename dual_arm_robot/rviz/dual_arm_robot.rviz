    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        /base_footprint:
          Value: true
        /base_link:
          Value: true
        /camera_link:
          Value: true
        /caster_caster:
          Value: true
        /lidar_link:
          Value: true
        /left_arm_base:
          Value: true
        /left_finger_left:
          Value: true
